#!/usr/bin/env bash
# Imprime la IP pública del servidor.
# En AWS la pide a los metadatos de la instancia (IMDSv2); en otro lado, a un servicio externo.
set -uo pipefail
es_ip() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; }

ip=""
token="$(curl -fs -m 2 -X PUT http://169.254.169.254/latest/api/token \
          -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' 2>/dev/null)" && \
  ip="$(curl -fs -m 2 -H "X-aws-ec2-metadata-token: $token" \
          http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)"

if ! es_ip "$ip"; then
  ip=""
  for url in https://checkip.amazonaws.com https://api.ipify.org https://ifconfig.me/ip; do
    ip="$(curl -fs -m 5 "$url" 2>/dev/null | tr -d '[:space:]')"
    if es_ip "$ip"; then break; fi
    ip=""
  done
fi

[[ -n "$ip" ]] || exit 1
echo "$ip"
