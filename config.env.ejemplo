# =============================================================================
#  SMART RACK - Configuración del servidor
#  Copia este archivo como "config.env" y completa los valores:
#       cp config.env.ejemplo config.env && nano config.env
#  (config.env está en .gitignore: NUNCA lo subas a GitHub, tiene contraseñas)
#
#  Las contraseñas solo pueden tener letras, números y estos símbolos: _ . @ # % + = : , -
#  (sin espacios, comillas, $, ` ni \  -> así no rompen ningún comando)
# =============================================================================

# ---------- DOMINIO ----------
# Dominio que apunta a la IP pública del servidor (ej. DuckDNS gratis: https://www.duckdns.org)
# Si lo dejas vacío, el servidor funciona solo por IP y sin HTTPS.
DOMINIO="smartrack-grupo1.duckdns.org"

# Token de DuckDNS (lo ves arriba en https://www.duckdns.org al iniciar sesión).
# Con esto el servidor actualiza SOLO el dominio con su nueva IP en cada arranque.
# Déjalo vacío si tu dominio es de otro proveedor y lo actualizas a mano.
DUCKDNS_TOKEN=""

# ---------- HTTPS (Let's Encrypt) ----------
EMAIL_CERTBOT="tu_correo@ejemplo.com"
# "si" = certificado de PRUEBA (el navegador lo marca como no seguro, pero no gasta
# el límite de Let's Encrypt de 5 certificados por semana para el mismo dominio).
CERTBOT_STAGING="no"
# HSTS obliga al navegador a usar siempre HTTPS. Déjalo en "no" mientras sigas
# recreando el servidor seguido (si un día no sale el certificado, no te quedas sin acceso).
CERTBOT_HSTS="no"

# ---------- ADMINISTRADORES DEL SERVIDOR (guía: "Crear usuario nuevo") ----------
# Cada uno queda como superusuario (sudo) y con la llave SSH de AWS (labsuser.pem).
# El acceso como root queda bloqueado.
USUARIOS_SO="frodriguez fpuma fzeballos atalavera"
# Contraseña Linux de todos (para entrar por SSH y para sudo).
# Escríbela solo aquí: config.env NO se sube a GitHub.
CLAVE_USUARIOS_SO=""
# "si" = se puede entrar por SSH con usuario + contraseña (fail2ban bloquea ataques).
# "no" = solo con la llave .pem
SSH_CON_CLAVE="si"

# ---------- MQTT (Mosquitto) ----------
# Usuario y clave que usa el ESP32 (deben coincidir con MQTT_USER / MQTT_PASSWORD del .ino)
MQTT_USUARIO="fzeballos"
MQTT_CLAVE="CambiaEstaClave2026"
# La guía del curso usa allow_anonymous true. Con IP pública cualquiera podría
# publicar en tu broker, por eso aquí viene en "no".
MQTT_PERMITIR_ANONIMO="no"

# ---------- DASHBOARD (login web con htpasswd de nginx) ----------
# Este mismo usuario/clave sirve también para MQTT por WebSocket (wss://DOMINIO/mqtt)
WEB_USUARIO="admin"
WEB_CLAVE=""            # vacía = se genera una al azar y se muestra al final

# ---------- EDITOR NODE-RED (https://DOMINIO/admin/) ----------
# Cuenta general del editor. Además, cada administrador de USUARIOS_SO entra
# con su propio usuario y CLAVE_USUARIOS_SO.
NODERED_USUARIO="admin"
NODERED_CLAVE=""        # vacía = se genera una al azar y se muestra al final

# ---------- OTROS ----------
ZONA_HORARIA="America/Lima"
# Hacer "apt upgrade" completo al instalar (más lento, pero es lo que pide la guía)
ACTUALIZAR_SO="si"
# Activar el firewall ufw además del Security Group de AWS
FIREWALL_UFW="si"
# Si vuelves a ejecutar el instalador, ¿reemplazar los flujos de Node-RED?
# "no" = conserva lo que hayas cambiado en el editor
ACTUALIZAR_FLOWS="no"

# ---------- AWS (solo lo usa aws/desplegar_aws.sh) ----------
# Repositorio PÚBLICO de GitHub donde subiste esta carpeta (sin config.env)
REPO_GIT="https://github.com/TU_USUARIO/smartrack-cloud.git"
RAMA_GIT="main"
TIPO_INSTANCIA="t3.small"
# PAR_LLAVES="vockey"        # en AWS Academy ya existe "vockey" (labsuser.pem)
REGION_AWS="us-east-1"
PILA_AWS="smartrack"
